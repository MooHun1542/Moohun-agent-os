function normalizePolicy(x){
  if(!x||typeof x!=='object')return x;
  x.status=x.status||'approved';
  x.riders=Array.isArray(x.riders)?x.riders:[];
  if(x.riders.length){
    const rt=x.riders.reduce((a,r)=>({premium:a.premium+(+r.premium||0),fyc:a.fyc+(+r.fyc||0),fyp:a.fyp+(+r.fyp||0)}),{premium:0,fyc:0,fyp:0});
    x.riderFyc=rt.fyc; x.riderFyp=rt.fyp;
    if(x.mainPremium!=null)x.premium=(+x.mainPremium||0)+rt.premium;
  }
  if(x.baseFyc!==null&&x.baseFyc!==undefined&&x.riderFyc!==null&&x.riderFyc!==undefined)x.fyc=(+x.baseFyc||0)+(+x.riderFyc||0);
